---
interface AlternateLink {
  code: string;
  name: string;
  url: string;
}

interface Props {
  currentLang?: string;
  alternatives?: AlternateLink[];
}
const { currentLang = 'en', alternatives = [] } = Astro.props;

// We only render language links if they are explicitly passed as known alternatives.
---
{alternatives.length > 0 && (
  <div class="lang-switcher" style="padding: 0.5rem; background: var(--color-secondary); display: flex; justify-content: flex-end; gap: 1rem;">
    {alternatives.map(lang => (
      <a href={lang.url} style={{ fontWeight: currentLang === lang.code ? 'bold' : 'normal' }}>
        {lang.name}
      </a>
    ))}
  </div>
)}
