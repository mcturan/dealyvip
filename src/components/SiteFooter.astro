---
interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;
---
<footer style="background: var(--color-slate-900); color: var(--color-slate-400); padding: var(--space-xl) var(--space-md); margin-top: var(--space-xxl);">
  <div style="max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: var(--space-xl);">
    
    <div>
      <h3 style="color: var(--color-slate-50); margin-bottom: var(--space-md);">DealyVIP</h3>
      <p style="font-size: 0.9rem;">Cross-border business coordination and verification.</p>
    </div>

    <div>
      <h3 style="color: var(--color-slate-50); margin-bottom: var(--space-md);">Navigation</h3>
      <nav aria-label="Footer Navigation" style="display: flex; flex-direction: column; gap: var(--space-sm);">
        <a href={`/${lang}/`} style="color: inherit; text-decoration: none;">Home</a>
        <a href={`/en/tools/`} style="color: inherit; text-decoration: none;">Tools</a>
        <a href={`/en/countries/`} style="color: inherit; text-decoration: none;">Countries</a>
        <a href={`/en/guides/`} style="color: inherit; text-decoration: none;">Guides</a>
        <a href={`/en/assistance/`} style="color: inherit; text-decoration: none;">Assistance</a>
      </nav>
    </div>

    <div>
      <h3 style="color: var(--color-slate-50); margin-bottom: var(--space-md);">Legal</h3>
      <nav aria-label="Footer Legal Navigation" style="display: flex; flex-direction: column; gap: var(--space-sm);">
        <a href={`/en/privacy/`} style="color: inherit; text-decoration: none;">Privacy Policy</a>
      </nav>
    </div>

  </div>
  
  <div style="max-width: 1200px; margin: var(--space-xl) auto 0; padding-top: var(--space-md); border-top: 1px solid var(--color-slate-800); text-align: center; font-size: 0.8rem;">
    &copy; {new Date().getFullYear()} DealyVIP. All rights reserved.
  </div>
</footer>
