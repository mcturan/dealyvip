---
interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;
---
<footer style="background-color: var(--color-slate-50); border-top: 1px solid var(--color-border); padding: var(--space-lg) 0 var(--space-md) 0; margin-top: auto;">
  <div class="container grid grid-cols-4" style="margin-bottom: var(--space-lg);">
    <div>
      <h3 style="font-size: 1.2rem; margin-bottom: var(--space-sm);">DealyVIP</h3>
      <p class="text-muted" style="font-size: 0.9rem; margin-bottom: var(--space-sm);">Independent verification and local assistance in restricted and emerging markets.</p>
    </div>
    
    
      
        <div>
          <h4 style="font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-slate-600); margin-bottom: var(--space-sm);">Services</h4>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.5rem;">
            <li><a href="/en/tools/" class="no-underline text-muted">Verification Tools</a></li>
            <li><a href="/en/assistance/" class="no-underline text-muted">Local Assistance</a></li>
            <li><a href="/en/guides/" class="no-underline text-muted">Business Guides</a></li>
          </ul>
        </div>
        <div>
          <h4 style="font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-slate-600); margin-bottom: var(--space-sm);">Locations</h4>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.5rem;">
            <li><a href="/en/countries/" class="no-underline text-muted">All Countries</a></li>
            <!-- Note: Linking directly to individual countries is disabled until those pages exist -->
          </ul>
        </div>
        <div>
          <h4 style="font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-slate-600); margin-bottom: var(--space-sm);">Legal & Trust</h4>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.5rem;">
            <li><a href="/en/what-we-do/" class="no-underline text-muted">What We Do</a></li>
            <li><a href="/en/contact/" class="no-underline text-muted">Contact</a></li>
            <li><a href="/en/privacy/" class="no-underline text-muted">Privacy Policy</a></li>
          </ul>
        </div>
      
    
  </div>
  <div class="container" style="text-align: center; color: var(--color-slate-600); font-size: 0.85rem; padding-top: var(--space-md); border-top: 1px solid var(--color-border);">
    &copy; {new Date().getFullYear( DealyVIP. All rights reserved.
  </div>
</footer>
