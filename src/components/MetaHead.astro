---
interface AlternateLink {
  code: string;
  name: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  canonical?: string;
  alternatives?: AlternateLink[];
  image?: string;
}

const { title, description, canonical, alternatives = [], image = '/og-default.jpg' } = Astro.props;

// Safe fallback for local dev. Strictly avoids localhost leaks in production builds without SITE_URL.
const siteUrl = Astro.site 
  ? Astro.site.toString().replace(/\/$/, '') 
  : ''; // If no SITE_URL is provided to the build, fallback is completely empty.

const canonicalUrl = canonical || (siteUrl ? `${siteUrl}${Astro.url.pathname}` : '');
const ogImage = siteUrl ? `${siteUrl}${image}` : image;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/favicon.svg" />
<title>{title} | DealyVIP</title>
<meta name="description" content={description} />
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
<meta property="og:title" content={`${title} | DealyVIP`} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
{siteUrl && alternatives.map(alt => (
  <link rel="alternate" hreflang={alt.code} href={`${siteUrl}${alt.url}`} />
))}
{siteUrl && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "DealyVIP",
    "url": siteUrl
  })} />
)}
