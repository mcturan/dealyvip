---
interface Props {
  name: string;
  description: string;
  url: string;
}
const { name, description, url } = Astro.props;
---
<a href={url} class="card card-hover no-underline" style="display: flex; flex-direction: column; justify-content: center; min-height: 120px;">
  <h3 style="margin-bottom: 0.25rem;">{name}</h3>
  <p class="text-muted" style="font-size: 0.9rem; margin-bottom: 0;">{description}</p>
</a>
