---
export interface Props {
  name: string;
  description: string;
}
const { name, description } = Astro.props;
---
<div class="country-coverage-card" style="background: white; border: 1px solid var(--color-border); border-radius: 8px; padding: var(--space-md); display: flex; align-items: center; gap: var(--space-md);">
  <div style="width: 60px; height: 60px; flex-shrink: 0; border-radius: 50%; background: var(--color-bg-alt); display: flex; align-items: center; justify-content: center; font-weight: bold; color: var(--color-slate-500); font-size: 1.2rem;">
    {name.substring(0,2).toUpperCase()}
  </div>
  <div>
    <h3 style="margin: 0 0 0.25rem 0; font-size: 1.1rem; color: var(--color-slate-900);">{name}</h3>
    <p class="text-muted" style="margin: 0; font-size: 0.9rem; line-height: 1.4;">{description}</p>
  </div>
</div>
