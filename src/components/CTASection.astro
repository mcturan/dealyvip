---
interface Props {
  title?: string;
  text?: string;
  btnText?: string;
  btnUrl?: string;
}
const { 
  title = "Require tailored local assistance?", 
  text = "Contact us to coordinate independent on-the-ground support.",
  btnText = "Contact DealyVIP",
  btnUrl = "/en/contact/"
} = Astro.props;
---
<section class="section section-bg-alt text-center" style="margin-top: var(--space-xl);">
  <div class="container">
    <h2 class="section-title">{title}</h2>
    <p class="lead" style="margin: 0 auto var(--space-md) auto;">{text}</p>
    <a href={btnUrl} class="btn btn-accent">{btnText}</a>
  </div>
</section>
