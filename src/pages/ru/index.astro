---
import BaseLayout from '../../layouts/BaseLayout.astro';

const alternatives = [
  { code: 'en', name: 'English', url: '/en/' },
  { code: 'tr', name: 'Türkçe', url: '/tr/' },
  { code: 'uk', name: 'Українська', url: '/uk/' },
  { code: 'ru', name: 'Русский', url: '/ru/' }
];
---
<BaseLayout title="Главная" description="Независимая проверка и местная поддержка." lang="ru" alternatives={alternatives}>
  <section class="text-center mb-2" style="padding: 4rem 1rem;">
    <h1 style="font-size: 2.5rem;">Управляйте трансграничным бизнесом уверенно</h1>
    
  </section>
</BaseLayout>
