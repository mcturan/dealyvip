---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GuideCard from '../../../components/GuideCard.astro';

const guides = await getCollection('guides', ({ id }) => id.startsWith('tr/'));
---
<BaseLayout title="İş Rehberleri" description="Sınır ötesi ticaret, şirket doğrulama ve yerel koordinasyon rehberleri." lang="tr">
  <div class="container section">
    <h1 class="display-title">İş Rehberleri</h1>
    <p class="lead mb-4">Sınır ötesi operasyonlar için pratik istihbarat ve doğrulama süreçleri.</p>
    
    <div class="grid grid-cols-3">
      {guides.map(guide => {
        const slug = guide.id.replace('tr/', '').replace(/\.md$/, '');
        return (
          <GuideCard 
            title={guide.data.title} 
            category={guide.data.topic || ""} 
            url={`/tr/guides/${slug}/`}
          />
        );
      })}
    </div>
  </div>
</BaseLayout>
