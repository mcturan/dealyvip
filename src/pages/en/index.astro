---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CountryCoverageCard from '../../components/CountryCoverageCard.astro';
import heroImg from '../../assets/images/hero.jpg';
import factoryImg from '../../assets/images/factory.jpg';

const alternatives = [
  { code: 'en', name: 'English', url: '/en/' },
  { code: 'tr', name: 'Türkçe', url: '/tr/' },
  { code: 'uk', name: 'Українська', url: '/uk/' },
  { code: 'ru', name: 'Русский', url: '/ru/' }
];
---
<BaseLayout 
  title="Practical Cross-Border Assistance & Verification" 
  description="Tell DealyVIP what you need. We investigate, verify, search, and coordinate local assistance in complex jurisdictions." 
  lang="en" 
  alternatives={alternatives}
>

  {/* SECTION A — HERO */}
  <section class="section hero-section">
    <div class="container">
      <div class="hero-layout">
        <div class="hero-content">
          <h1 class="display-title hero-title">
            Cross-border business is complicated. <span style="color: var(--color-primary);">Finding the truth shouldn't be.</span>
          </h1>
          <p class="lead text-muted hero-lead">
            You have a cross-border problem, verification need, sourcing need, or local coordination requirement. Tell DealyVIP what you need. We investigate, verify available information, and provide practical local assistance.
          </p>
          <div class="hero-actions">
            <a href="/en/contact/" class="btn btn-primary">Start your request</a>
            <a href="#how-it-works" class="btn btn-outline">See how we help</a>
          </div>
        </div>
        <div class="hero-visual">
          <Image src={heroImg} alt="Logistics and Cross-Border Verification" width={800} height={500} format="webp" class="hero-image" />
        </div>
      </div>
    </div>
  </section>

  {/* SECTION B — WHAT DO YOU NEED? */}
  <section class="section section-bg-alt">
    <div class="container">
      <div style="text-align: center; margin-bottom: var(--space-xl);">
        <h2 class="section-title">What do you need help with?</h2>
        <p class="text-muted" style="max-width: 600px; margin: 0 auto;">We don't just point you to public registries. We perform the legwork, navigate the local language, and provide evidence-based findings.</p>
      </div>
      <div class="grid grid-cols-2" style="gap: var(--space-lg);">
        <ServiceCard 
          title="Verify & Research" 
          description="Check if a company or business presence appears legitimate. We review available local registries, public records, and on-the-ground reality."
          icon="search"
        />
        <ServiceCard 
          title="Find a Supplier / Source" 
          description="Looking for manufacturers or products in specific regions? We help discover and pre-qualify potential partners based on your criteria."
          icon="box"
        />
      </div>
    </div>
  </section>

  {/* SPLIT SECTION FOR LOCAL ASSISTANCE */}
  <section class="section">
    <div class="container">
      <div class="split-layout">
        <div class="split-image-container">
          <Image src={factoryImg} alt="Factory inspection and local assistance" width={600} height={400} format="webp" class="split-image" />
        </div>
        <div class="split-content">
          <h2 class="section-title" style="margin-bottom: var(--space-sm);">Local Assistance & Coordination</h2>
          <p class="text-muted" style="margin-bottom: var(--space-md); font-size: 1.1rem; line-height: 1.6;">
            Need someone to visit a factory, check a physical address, or assist with local meetings? 
            Navigating complex jurisdictions, compliance requirements, or language barriers is much safer when you have trusted eyes on the ground.
          </p>
          <ul class="benefit-list">
            <li>Physical Site Verification</li>
            <li>Business Meeting Coordination</li>
            <li>Local Translation & Orientation</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* SECTION C — HOW IT WORKS */}
  <section id="how-it-works" class="section section-bg-alt">
    <div class="container">
      <h2 class="section-title" style="text-align: center; margin-bottom: var(--space-lg);">The Process</h2>
      <div class="timeline">
        <div class="timeline-step">
          <div class="timeline-marker">1</div>
          <div class="timeline-content">
            <h3>Tell us what you need</h3>
            <p class="text-muted">Submit your problem, target company, or sourcing requirements via our structured intake form.</p>
          </div>
        </div>
        <div class="timeline-step">
          <div class="timeline-marker">2</div>
          <div class="timeline-content">
            <h3>Scope & Review</h3>
            <p class="text-muted">We review what is realistically possible, outline the approach, and confirm feasibility.</p>
          </div>
        </div>
        <div class="timeline-step">
          <div class="timeline-marker">3</div>
          <div class="timeline-content">
            <h3>Research & Coordinate</h3>
            <p class="text-muted">We verify public records, contact sources, or arrange local visits depending on the agreed scope.</p>
          </div>
        </div>
        <div class="timeline-step">
          <div class="timeline-marker">4</div>
          <div class="timeline-content">
            <h3>Findings Delivered</h3>
            <p class="text-muted">You receive an evidence-based report or actionable next steps to proceed safely.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* SECTION E — COUNTRIES */}
  <section class="section">
    <div class="container">
      <div style="max-width: 600px; margin-bottom: var(--space-lg);">
        <h2 class="section-title">Service Contexts</h2>
        <p class="text-muted">We maintain focused expertise and local operational networks in specific jurisdictions where remote checks frequently fail.</p>
      </div>
      <div class="grid grid-cols-2" style="gap: var(--space-md);">
        <CountryCoverageCard name="Türkiye" description="Extensive company verification, factory visits, and manufacturing sourcing." />
        <CountryCoverageCard name="Ukraine" description="Operating under constraints. Verification of active businesses and logistical coordination." />
        <CountryCoverageCard name="Russia" description="Navigating compliance environments, sanctions restrictions, and legal entity verification." />
        <CountryCoverageCard name="Iran" description="Sanctions awareness, permissible entity checking, and risk-management research." />
      </div>
    </div>
  </section>

  {/* SECTION F — TRUST & LIMITATIONS */}
  <section class="section section-bg-alt">
    <div class="container">
      <div class="trust-banner">
        <h2 class="section-title" style="margin-bottom: var(--space-md);">Honest Boundaries</h2>
        <div class="trust-grid">
          <div class="trust-item">
            <strong>Evidence-Based</strong>
            <p class="text-muted">Our research relies on available public information, registry data, and local inquiries. We do not possess magic databases.</p>
          </div>
          <div class="trust-item">
            <strong>No Legal Conclusions</strong>
            <p class="text-muted">We provide factual findings, not legal guarantees or certified fraud-prevention.</p>
          </div>
          <div class="trust-item">
            <strong>Compliance First</strong>
            <p class="text-muted">We strictly observe international sanctions boundaries and will decline requests outside permissible scopes.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* SECTION G — FINAL CTA */}
  <CTASection 
    title="Ready to get started?" 
    text="Stop guessing. Let us find the facts." 
    btnText="Request Assistance" 
    btnUrl="/en/contact/" 
  />

</BaseLayout>
