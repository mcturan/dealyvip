---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import CountryCard from '../../components/CountryCard.astro';
import GuideCard from '../../components/GuideCard.astro';
import NeedCard from '../../components/NeedCard.astro';

const alternatives = [
  { code: 'en', name: 'English', url: '/en/' },
  { code: 'tr', name: 'Türkçe', url: '/tr/' },
  { code: 'uk', name: 'Українська', url: '/uk/' },
  { code: 'ru', name: 'Русский', url: '/ru/' }
];
---
<BaseLayout 
  title="Independent Business Verification & Local Assistance" 
  description="DealyVIP coordinates independent verification, supplier discovery, and local assistance in Türkiye, Ukraine, Russia, and Iran." 
  lang="en" 
  alternatives={alternatives}
>

  <section class="section text-center" style="padding-top: var(--space-xl); padding-bottom: var(--space-lg);">
    <div class="container">
      <h1 class="display-title">Cross-Border Business,<br/>Verified on the Ground</h1>
      <p class="lead" style="margin: 0 auto var(--space-md) auto;">
        We coordinate independent verification, supplier discovery, and local assistance across Türkiye, Ukraine, Russia, and Iran. Avoid fraud, navigate constraints, and establish secure trade channels.
      </p>
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="/en/assistance/" class="btn btn-accent">Request Local Assistance</a>
        <a href="/en/guides/" class="btn btn-outline">Read Business Guides</a>
      </div>
    </div>
  </section>

  <section class="section section-bg-alt">
    <div class="container">
      <div style="max-width: 600px; margin-bottom: var(--space-md);">
        <h2 class="section-title">Explore by Country</h2>
        <p class="text-muted">Regional knowledge mapping compliance environments, operational constraints, and on-the-ground reality.</p>
      </div>
      <div class="grid grid-cols-4">
        <CountryCard name="Türkiye" description="Sourcing & Verification" />
        <CountryCard name="Ukraine" description="Operating under constraints" />
        <CountryCard name="Russia" description="Compliance & Exemptions" />
        <CountryCard name="Iran" description="Sanctions & Restrictions" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Explore by Need</h2>
      <div class="grid grid-cols-3">
        <NeedCard title="Verify a Company" />
        <NeedCard title="Find Suppliers" />
        <NeedCard title="Visit a Factory or Business" />
        <NeedCard title="Arrange a Business Meeting" />
        <NeedCard title="Find Local Assistance" url="/en/assistance/" />
        <NeedCard title="Business Travel & Communication" />
      </div>
    </div>
  </section>

  <section class="section section-bg-alt">
    <div class="container">
      <h2 class="section-title">Business Guides</h2>
      <div class="grid grid-cols-3">
        <GuideCard 
          title="Overseas Supplier Pre-Payment Checklist" 
          category="Verification & Trust" 
        />
        <!-- Structural placeholder cards to demonstrate layout -->
        <GuideCard 
          title="Understanding Turkish Corporate Registries" 
          category="Market Entry" 
        />
        <GuideCard 
          title="Navigating Sanctions: Sector Exemptions" 
          category="Compliance" 
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width: var(--content-width); margin: 0 auto;">
      <h2 class="section-title text-center">The DealyVIP Approach</h2>
      <div style="display: flex; flex-direction: column; gap: var(--space-md); margin-top: var(--space-md);">
        <div>
          <h3>Clear Information</h3>
          <p class="text-muted">We do not provide vague consulting. We provide exact procedural guides on how to establish trust and execute transactions in challenging environments.</p>
        </div>
        <div>
          <h3>Acknowledged Limitations</h3>
          <p class="text-muted">We state clearly what is impossible. We do not invent workarounds for hard sanctions or pretend high-risk environments are safe.</p>
        </div>
        <div>
          <h3>Coordinated On-the-Ground Support</h3>
          <p class="text-muted">When remote verification is insufficient, we coordinate with local independent professionals to physically inspect goods, visit factories, or facilitate meetings.</p>
        </div>
      </div>
    </div>
  </section>

  <CTASection />

</BaseLayout>
