---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
---
<BaseLayout title="Local Assistance" description="Coordinate independent local support for cross-border business." lang="en">
  <div class="container section">
    <h1 class="display-title">Local Business Assistance</h1>
    <div style="max-width: var(--content-width); margin-bottom: var(--space-xl);">
      <p class="lead mb-2">When remote information isn't enough, physical presence is required. We help coordinate independent local support to verify, facilitate, and protect your interests.</p>
      
      <h2 class="section-title">Situations for Local Assistance</h2>
      <ul class="mb-4" style="padding-left: 1.5rem;">
        <li class="mb-1"><strong>Factory & Business Visits:</strong> Independent physical verification of a supplier's premises, production capacity, and inventory.</li>
        <li class="mb-1"><strong>Business Meeting Coordination:</strong> Structuring effective local meetings with partners.</li>
        <li class="mb-1"><strong>Interpreter Coordination:</strong> Sourcing trusted professional translators for negotiations.</li>
        <li class="mb-1"><strong>Practical Local Orientation:</strong> Safe and efficient travel coordination in complex environments.</li>
      </ul>
      
      <div class="card" style="background: var(--color-slate-50); border: 1px solid var(--color-border); margin-top: var(--space-md);">
        <h3 style="color: var(--color-primary); margin-bottom: 0.5rem;">Availability Notice</h3>
        <p style="margin-bottom: 0; font-size: 0.95rem; color: var(--color-text-muted);">Assistance may be coordinated or evaluated depending entirely on the specific request, security conditions, and local operational availability. DealyVIP acts as a coordination layer and does not directly perform all services.</p>
      </div>
    </div>
  </div>
  <CTASection title="Request Coordination" text="Detail your requirements and we will review feasibility." />
</BaseLayout>
