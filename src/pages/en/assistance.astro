---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
---
<BaseLayout title="Local Assistance" description="Coordinate independent local support for cross-border business." lang="en">
  
  <section class="section" style="padding-top: var(--space-xl); padding-bottom: var(--space-xl); background: #f8fafc;">
    <div class="container text-center">
      <h1 class="display-title" style="margin-bottom: var(--space-md);">Local Business Assistance</h1>
      <p class="lead text-muted" style="max-width: 700px; margin: 0 auto;">When remote information isn't enough, physical presence is required. We coordinate independent local support to verify, facilitate, and protect your interests on the ground.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid" style="grid-template-columns: 1fr 1fr; gap: var(--space-2xl); align-items: start;">
        
        <div>
          <h2 style="font-size: 1.75rem; margin-bottom: var(--space-md);">When to use local assistance</h2>
          
          <div style="display: flex; flex-direction: column; gap: var(--space-md);">
            <div style="background: white; border: 1px solid var(--color-border); padding: var(--space-md); border-radius: 8px;">
              <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem; color: var(--color-primary);">Factory & Business Visits</h3>
              <p class="text-muted" style="margin: 0;">Independent physical verification of a supplier's premises, production capacity, and inventory. Don't rely on photos sent via email.</p>
            </div>
            
            <div style="background: white; border: 1px solid var(--color-border); padding: var(--space-md); border-radius: 8px;">
              <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem; color: var(--color-primary);">Business Meeting Coordination</h3>
              <p class="text-muted" style="margin: 0;">Structuring effective local meetings with partners, ensuring cultural and logistical alignment before you arrive.</p>
            </div>

            <div style="background: white; border: 1px solid var(--color-border); padding: var(--space-md); border-radius: 8px;">
              <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem; color: var(--color-primary);">Interpreter Sourcing</h3>
              <p class="text-muted" style="margin: 0;">Sourcing trusted professional translators for negotiations so you aren't relying on the supplier's staff.</p>
            </div>
          </div>
        </div>
        
        <div>
          <div style="background: #fffbeb; border: 1px solid #fde68a; padding: var(--space-lg); border-radius: 12px; margin-top: var(--space-lg);">
            <h3 style="color: #b45309; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
              Availability Notice
            </h3>
            <p style="margin-bottom: 0.75rem; color: #92400e;">
              Assistance is coordinated or evaluated depending entirely on the specific request, local security conditions, and operational availability.
            </p>
            <p style="margin-bottom: 0; color: #92400e; font-weight: 500;">
              DealyVIP acts as a coordination layer. We assess the feasibility of your request before confirming engagement.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <CTASection 
    title="Request Coordination" 
    text="Detail your requirements and we will review feasibility." 
    btnText="Contact Us" 
    btnUrl="/en/contact/" 
  />
</BaseLayout>
