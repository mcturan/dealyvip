---
import BaseLayout from '../../layouts/BaseLayout.astro';

const alternatives = [
  { code: 'en', name: 'English', url: '/en/' },
  { code: 'tr', name: 'Türkçe', url: '/tr/' },
  { code: 'uk', name: 'Українська', url: '/uk/' }
];
---
<BaseLayout 
  title="Незалежна перевірка бізнесу та місцева координація" 
  description="DealyVIP координує незалежну перевірку, пошук постачальників та місцеву допомогу в Туреччині." 
  lang="uk" 
  alternatives={alternatives}
>
  <section class="section text-center" style="padding-top: var(--space-xl); padding-bottom: var(--space-lg);">
    <div class="container">
      <h1 class="display-title">Транскордонний бізнес,<br/>перевірений на місці</h1>
      <p class="lead" style="margin: 0 auto var(--space-md) auto;">
        DealyVIP надає практичну інформацію та орієнтири для українців, які оцінюють компанії, постачальників та питання транскордонного бізнесу, пов'язані з Туреччиною.
      </p>
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="/uk/guides/" class="btn btn-accent">Читати посібники</a>
      </div>
    </div>
  </section>
</BaseLayout>
