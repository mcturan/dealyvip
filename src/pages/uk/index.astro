---
import BaseLayout from '../../layouts/BaseLayout.astro';

const alternatives = [
  { code: 'en', name: 'English', url: '/en/' },
  { code: 'tr', name: 'Türkçe', url: '/tr/' },
  { code: 'uk', name: 'Українська', url: '/uk/' },
  { code: 'ru', name: 'Русский', url: '/ru/' }
];
---
<BaseLayout title="Головна" description="Незалежна перевірка та місцева підтримка." lang="uk" alternatives={alternatives}>
